{
  "project": {
    "name": "Restaurant POS",
    "code": "restaurant-pos",
    "platform": "android_apk",
    "icon": "utensils",
    "description": "Restaurant POS: tables, orders, kitchen, billing with Parent/Child devices (offline, Android).",
    "current_version": "0.1.0",
    "min_supported_version": "0.1.0"
  },
  "permission_schema": [
    {
      "module": "restaurant",
      "label": "Restaurant",
      "icon": "utensils",
      "description": "Core restaurant operations.",
      "features": [
        { "key": "restaurant.orders", "label": "Orders & Kitchen", "description": "Tables, orders, kitchen workflow", "default": true },
        { "key": "restaurant.billing", "label": "Billing & Payments", "description": "Bills, payments, receipts", "default": true },
        { "key": "restaurant.reports", "label": "Reports", "description": "Sales summaries", "default": true }
      ]
    },
    {
      "module": "network",
      "label": "Device Network",
      "icon": "wifi",
      "description": "Parent/Child devices.",
      "features": [
        { "key": "network.children", "label": "Child Devices", "description": "Allow child devices to join this Parent (the license belongs to the Parent only)", "default": true }
      ]
    }
  ]
}
